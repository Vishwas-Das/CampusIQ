# ══════════════════════════════════════════════
# CampusIQ Backend Environment Variables
# Copy to .env and fill in the values.
# Never commit .env to git.
# ══════════════════════════════════════════════

# ── Database (Supabase PostgreSQL) ──
# Get this from:
# https://supabase.com/dashboard/project/<your-project-ref>/settings/database
# Use the "Session" pooler (port 5432) for long-lived dev connections;
# the "Transaction" pooler (port 6543) is fine for serverless-style usage.
DATABASE_URL=postgresql+psycopg2://postgres.<your-project-ref>:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── Supabase ──
# Project ID: <your-project-ref> (region: ap-south-1)
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Anon key — copy from Supabase dashboard → Settings → API keys.
# Public-by-design; RLS protects access. Still keep it out of git.
SUPABASE_ANON_KEY=[COPY-FROM-DASHBOARD]
# Service role key — bypasses RLS. Keep it secret.
# https://supabase.com/dashboard/project/<your-project-ref>/settings/api-keys
SUPABASE_SERVICE_ROLE_KEY=[COPY-FROM-DASHBOARD]
# Storage bucket for documents + audio (deferred until prod migration).
SUPABASE_STORAGE_BUCKET=campusiq-documents

# ── Auth ──
# Generate a fresh secret with: python -c "import secrets; print(secrets.token_hex(32))"
# DO NOT ship the literal default — config rejects "change-me-in-production"
# at startup when ENVIRONMENT=production.
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Redis (Phase 12+; not currently required for demo) ──
REDIS_URL=redis://localhost:6379/0

# ── AI Services ──
# Claude (Anthropic). Default model is Haiku for all dev/test (cheap).
# Flip USE_PRODUCTION_MODEL=true ONLY for the final demo to switch to Opus.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_DEV=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_PROD=claude-opus-4-6
USE_PRODUCTION_MODEL=False

# OpenAI Whisper — fallback ASR if ElevenLabs Scribe is off. Optional.
# When unset, the frontend's browser SpeechRecognition kicks in automatically.
OPENAI_API_KEY=

# ElevenLabs — primary ASR (Scribe) + TTS for the voice interview.
# When unset, the frontend's browser speechSynthesis kicks in automatically.
ELEVENLABS_API_KEY=

# ── CORS ──
# Local dev:
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# For the hosted Render deploy, set CORS_ALLOWED_ORIGINS to the Vercel
# domain(s), e.g. "https://campusiq.vercel.app,https://www.campusiq.app"
# — comma-separated. See `render.yaml` for the blueprint.

# ── Audio cleanup ──
AUDIO_RETENTION_DAYS=7
AUDIO_CLEANUP_INTERVAL_HOURS=6

# ── Rate limiting (Phase 21) ──
# Per-user budget on Claude-touching endpoints. The default of 20/min is
# comfortable for a demo and cheap to enforce in-process. Increase if a
# live user hits 429 during the script.
CLAUDE_REQUESTS_PER_MINUTE=20

# ── App ──
ENVIRONMENT=development
