# ══════════════════════════════════════════════
# CampusIQ Frontend Environment Variables
# Copy to .env (not .env.local — Vite reads .env in dev).
# Never commit .env to git.
# ══════════════════════════════════════════════

# Backend API base URL.
# Local dev: http://127.0.0.1:8000/api/v1
# Production: https://<your-backend-host>/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Supabase project — used by frontend if/when it talks to Storage / Auth directly.
# Project ID: <your-project-ref>
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=[COPY-FROM-DASHBOARD]
